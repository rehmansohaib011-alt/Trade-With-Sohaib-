<!DOCTYPE html>
<html lang="hi"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Alpha Desk</title>
<style>
:root{--c:#101216;--l:#22252d;--t:#f4f5f7;--m:#858b9a;--up:#20c58a;--dn:#f0525a;--g:#f0c53a}
body{background:#000;margin:0}
.ad{max-width:520px;margin:auto;padding:14px 14px 96px;min-height:100vh;background:#000;color:var(--t);font:14px system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
*{box-sizing:border-box;margin:0;padding:0;font-family:inherit}
small{color:var(--m);font-size:11px;display:block}
.up{color:var(--up)}.dn{color:var(--dn)}.rt{text-align:right}
.hd{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.brand{font-weight:900;letter-spacing:2px;font-size:19px;color:var(--g)}
.live{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--m)}
.live i{width:7px;height:7px;border-radius:50%;background:var(--dn)}
.live i.on{background:var(--up);box-shadow:0 0 8px var(--up)}
.stats{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:6px;margin-bottom:14px}
.stats div{background:var(--c);border:1px solid var(--l);border-radius:11px;padding:8px 9px}
.stats b{display:block;font-size:15px;margin-top:2px}
.tr{background:var(--c);border:1px solid var(--l);border-radius:14px;padding:12px;margin-bottom:10px;cursor:pointer}
.r1{display:flex;gap:6px;align-items:center;margin-bottom:10px}
.r1 b{font-size:16px;margin-right:2px}
.tg{font-size:11px;padding:2px 7px;border-radius:5px;background:#23262d;color:#cfd3dc}
.tg.L{background:#12382c;color:var(--up)}.tg.S{background:#3a1a1e;color:var(--dn)}
.r2,.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
.r2{grid-template-columns:1fr 1fr;margin-bottom:10px}
.r2 h3{font-size:21px;margin-top:2px}
.g3{row-gap:8px;font-size:13px}
.pt{margin-top:10px;padding-top:8px;border-top:1px dashed var(--l);display:flex;justify-content:space-between;font-size:12px}
.emp{text-align:center;color:var(--m);padding:40px 0;line-height:1.7}
input{width:100%;background:#0a0c10;border:1px solid var(--l);color:var(--t);border-radius:9px;padding:10px;font-size:14px;outline:none}
input:focus{border-color:var(--g)}
.bt{background:#23262d;color:var(--t);border:0;border-radius:8px;padding:7px 10px;font-size:12px;font-weight:700;cursor:pointer}
.fab{position:fixed;left:50%;transform:translateX(-50%);bottom:18px;padding:13px 30px;border:0;border-radius:30px;background:linear-gradient(135deg,#f6d55c,#c99a14);color:#1a1400;font-weight:800;font-size:15px;box-shadow:0 6px 24px #000c;cursor:pointer;z-index:5}
.ov{position:fixed;inset:0;background:#000b;backdrop-filter:blur(4px);display:none;align-items:center;justify-content:center;padding:12px;z-index:99;overflow:auto}
.ov.show{display:flex}
.bx{width:100%;max-width:380px;background:var(--c);border:1px solid var(--l);border-radius:16px;padding:14px}
.bx h4{margin-bottom:10px;font-size:15px}
.fg{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px}
.fg label{font-size:11px;color:var(--m);display:block;margin-bottom:3px}
.sd{display:flex;gap:6px}
.sd button{flex:1;padding:10px;border-radius:9px;border:1px solid var(--l);background:#0a0c10;color:var(--m);font-weight:800;cursor:pointer}
.sd .on.L{background:var(--up);color:#03140d}.sd .on.S{background:var(--dn);color:#1a0406}
.pv{background:#0a0c10;border:1px dashed var(--l);border-radius:10px;padding:9px;font-size:12.5px;line-height:1.8;margin-bottom:10px}
.pv div{display:flex;justify-content:space-between}
.go{width:100%;padding:12px;border:0;border-radius:10px;background:var(--g);color:#1a1400;font-weight:800;font-size:14px;cursor:pointer}
.sc{border-radius:18px;overflow:hidden;border:1px solid var(--l);background:#000}
.top{padding:20px;min-height:320px;background:radial-gradient(360px 240px at 100% 100%,#1f5a2a88,transparent),radial-gradient(260px 180px at 100% 55%,#f0c53a26,transparent),linear-gradient(#000 45%,#08170b)}
.logo{color:var(--g);font-weight:900;letter-spacing:3px;font-size:20px;margin-bottom:26px}
.pr{font-size:22px;font-weight:700}.pr small{display:inline;margin-left:8px;font-size:13px}
.ls{margin:6px 0 14px;font-size:15px}
.big{font-size:46px;font-weight:800;line-height:1}
.us{margin-top:6px;font-weight:600}
.kv{margin-top:34px;color:var(--m);font-size:15px}
.kv div{margin-top:5px}.kv b{color:var(--t);margin-left:8px}.kv .ts{font-size:12px}
.ft{background:#1d1d1d;padding:12px 16px;font-size:12px;color:var(--m)}.ft b{color:var(--t)}
.ctl{margin-top:10px;background:var(--c);border:1px solid var(--l);border-radius:14px;padding:10px}
.row{display:flex;gap:8px}.row .bt{flex:1;padding:10px}
}
</style></head>
<body>
<div class="ad">
 <div class="hd"><div><div class="brand" id="brand"></div><small>Personal Trading Desk</small></div><div class="live"><i id="dot"></i><span id="src">connecting...</span></div></div>
 <div class="stats">
  <div><small>Total PnL (USDT)</small><b id="sP">0.00</b></div>
  <div><small>Open Trades</small><b id="sN">0</b></div>
  <div><small>In Profit</small><b class="up" id="sW">0</b></div>
  <div><small>In Loss</small><b class="dn" id="sL">0</b></div>
 </div>
 <div id="vA"></div>
 <button class="fab" id="fab">+ Add Trade</button>

 <div class="ov" id="ovA"><div class="bx">
  <h4>New Trade</h4>
  <div class="fg"><div><label>Coin</label><input id="fc" placeholder="AVAX / BTC"></div>
   <div><label>Side</label><div class="sd"><button class="L on" id="bL">Long</button><button class="S" id="bS">Short</button></div></div></div>
  <div class="fg"><div><label>Leverage (x)</label><input id="fl" type="number" value="20"></div>
   <div><label>Margin (USDT)</label><input id="fm" type="number" step="any" placeholder="10"></div></div>
  <div class="fg"><div style="grid-column:1/-1"><label>Entry price (jis price pe trade li)</label><input id="fe" type="number" step="any"></div></div>
  <div class="fg"><div><label>Take Profit (optional)</label><input id="ft" type="number" step="any"></div>
   <div><label>Stop Loss (optional)</label><input id="fs" type="number" step="any"></div></div>
  <div class="pv" id="pv"></div>
  <div class="row"><button class="bt" id="aX">Cancel</button><button class="go" id="aS" style="flex:2">Add Trade</button></div>
 </div></div>

 <div class="ov" id="ovC"><div style="width:100%;max-width:360px">
  <div class="sc" id="sc"></div>
  <div class="ctl"><div class="fg"><div><label>TP price</label><input id="cT" type="number" step="any"></div><div><label>SL price</label><input id="cS" type="number" step="any"></div></div>
   <div class="row"><button class="bt" id="cU">Update TP/SL</button><button class="bt dn" id="cD">Close Trade</button><button class="bt" id="cX">✕</button></div></div>
 </div></div>
</div>

<script>
//<![CDATA[
(function(){
var BRAND="ALPHA DESK",K1="ad_t2";
var $=function(i){return document.getElementById(i)};
function ld(k,d){try{var v=JSON.parse(localStorage.getItem(k));return v||d}catch(e){return d}}
var T=ld(K1,[]),P={},BB={},sd=1,cur=-1,tm=0;
function sv(){try{localStorage.setItem(K1,JSON.stringify(T))}catch(e){}}
function fp(n){if(n==null||isNaN(n))return"--";var a=Math.abs(n),d=a>=100?2:a>=1?3:5;return n.toLocaleString("en-US",{minimumFractionDigits:d,maximumFractionDigits:d})}
function fs(n,d){return(n>=0?"+":"")+n.toFixed(d==null?2:d)}
function cl(n){return n>=0?"up":"dn"}
function sym(s){s=(s||"").toUpperCase().replace(/[^A-Z0-9]/g,"");return s&&!/USDT$/.test(s)?s+"USDT":s}
function calc(t,p){var d=t.sd*(p-t.en)*(t.mg*t.lv/t.en);return{pnl:d,roi:d/t.mg*100}}
function liq(t){return t.sd>0?t.en*(1-1/t.lv):t.en*(1+1/t.lv)}
function now(){var d=new Date(),p=function(x){return("0"+x).slice(-2)};return p(d.getMonth()+1)+"/"+p(d.getDate())+" "+p(d.getHours())+":"+p(d.getMinutes())+":"+p(d.getSeconds())}

function render(){
 var tp=0,w=0,l=0,h="";
 T.forEach(function(t,i){
  var m=P[t.s],c=m?calc(t,m):null,x=t.tp?calc(t,t.tp):null,y=t.sl?calc(t,t.sl):null,k=c?cl(c.pnl):"";
  if(c){tp+=c.pnl;c.pnl>=0?w++:l++}
  h+='<div class="tr" data-i="'+i+'"><div class="r1"><b>'+t.s+'</b><span class="tg '+(t.sd>0?"L":"S")+'">'+(t.sd>0?"Long":"Short")+'</span><span class="tg">Perp</span><span class="tg">'+t.lv+'x</span></div>'
  +'<div class="r2"><div><small>Unrealized PnL (USDT)</small><h3 class="'+k+'">'+(c?fs(c.pnl,4):"--")+'</h3></div><div class="rt"><small>ROI</small><h3 class="'+k+'">'+(c?fs(c.roi)+'%':"--")+'</h3></div></div>'
  +'<div class="g3"><div><small>Amount</small>'+(t.mg*t.lv).toFixed(2)+'</div><div><small>Margin</small>'+(+t.mg).toFixed(4)+'</div><div class="rt"><small>Liq. (approx)</small>'+fp(liq(t))+'</div>'
  +'<div><small>Entry price</small>'+fp(t.en)+'</div><div><small>Current price</small>'+(m?fp(m):"loading...")+'</div><div class="rt"><small>TP / SL</small>'+(t.tp?fp(t.tp):"--")+' / '+(t.sl?fp(t.sl):"--")+'</div></div>'
  +((x||y)?'<div class="pt"><span class="up">'+(x?'TP pe '+fs(x.pnl)+'$ ('+fs(x.roi,0)+'%)':'TP --')+'</span><span class="dn">'+(y?'SL pe '+fs(y.pnl)+'$ ('+fs(y.roi,0)+'%)':'SL --')+'</span></div>':'')+'</div>';
 });
 $("vA").innerHTML=h||'<div class="emp">Abhi koi trade nahi.<br>Neeche "+ Add Trade" dabao</div>';
 var e=$("sP");e.textContent=fs(tp,4);e.className=cl(tp);
 $("sN").textContent=T.length;$("sW").textContent=w;$("sL").textContent=l;
 if($("ovC").classList.contains("show"))card();
 if($("ovA").classList.contains("show"))pvw();
}
function card(){
 var t=T[cur];if(!t)return;var m=P[t.s],c=m?calc(t,m):null,k=c?cl(c.pnl):"";
 $("sc").innerHTML='<div class="top"><div class="logo">◆ '+BRAND+'</div><div class="pr">'+t.s+'<small>Perp</small></div><div class="ls '+(t.sd>0?"up":"dn")+'">'+(t.sd>0?"Long":"Short")+' | '+t.lv+'x</div><div class="big '+k+'">'+(c?fs(c.roi)+'%':"--")+'</div><div class="us '+k+'">'+(c?fs(c.pnl,4)+' USDT':"price aa rahi hai...")+'</div><div class="kv"><div>Entry price<b>'+fp(t.en)+'</b></div><div>Mark price<b>'+fp(m)+'</b></div><div class="ts">Time shared: '+now()+'</div></div></div><div class="ft">Personal Dashboard · <b>'+BRAND+'</b></div>';
}
function pvw(){
 var s=sym($("fc").value),lv=+$("fl").value,mg=+$("fm").value,en=+$("fe").value,tp=+$("ft").value,sl=+$("fs").value,m=P[s],h="";
 if(s)h+='<div><span>Current price (auto)</span><b>'+(m?fp(m):"dhoondh raha...")+'</b></div>';
 if(lv>0&&mg>0&&en>0){
  var t={sd:sd,lv:lv,mg:mg,en:en};
  if(m){var c=calc(t,m);h+='<div class="'+cl(c.pnl)+'"><span>Abhi ka PnL</span><b>'+fs(c.pnl)+'$ ('+fs(c.roi)+'%)</b></div>'}
  h+='<div><span>Position size</span><b>'+(mg*lv).toFixed(2)+' USDT</b></div><div><span>Liq. (approx)</span><b>'+fp(liq(t))+'</b></div>';
  if(tp>0){var x=calc(t,tp);h+='<div class="up"><span>Profit at TP</span><b>'+fs(x.pnl)+'$ ('+fs(x.roi,0)+'%)</b></div>'}
  if(sl>0){var y=calc(t,sl);h+='<div class="dn"><span>Loss at SL</span><b>'+fs(y.pnl)+'$ ('+fs(y.roi,0)+'%)</b></div>'}
 }
 $("pv").innerHTML=h||"Coin aur entry price daalo — current price aur profit/loss yahin dikhega";
}
function stat(t,on){$("src").textContent=t;$("dot").className=on?"on":""}
function setP(s,p){if(p>0)P[s]=p}
function fb(s){
 fetch("https://api.bybit.com/v5/market/tickers?category=linear&symbol="+s).then(function(r){return r.json()}).then(function(j){
  var x=j.result&&j.result.list&&j.result.list[0];if(x){BB[s]=1;setP(s,+x.lastPrice);render()}}).catch(function(){});
}
function after(ok){
 var n={};T.forEach(function(t){n[t.s]=1});
 Object.keys(n).forEach(function(s){if(!ok||BB[s]||!(s in P))fb(s)});
 render();
}
function pull(){
 fetch("https://fapi.binance.com/fapi/v1/ticker/price").then(function(r){return r.json()}).then(function(a){
  a.forEach(function(x){setP(x.symbol,+x.price)});stat("Live prices",1);after(true);
 }).catch(function(){stat("Backup feed",1);after(false)});
}

$("brand").textContent=BRAND;
$("fab").onclick=function(){["fc","fm","fe","ft","fs"].forEach(function(i){$(i).value=""});$("ovA").classList.add("show");pvw()};
$("vA").onclick=function(e){var n=e.target.closest(".tr");if(!n)return;cur=+n.dataset.i;var t=T[cur];$("cT").value=t.tp||"";$("cS").value=t.sl||"";card();$("ovC").classList.add("show")};
$("bL").onclick=function(){sd=1;$("bL").className="L on";$("bS").className="S";pvw()};
$("bS").onclick=function(){sd=-1;$("bS").className="S on";$("bL").className="L";pvw()};
["fc","fl","fm","fe","ft","fs"].forEach(function(i){$(i).oninput=function(){pvw();if(i==="fc"){clearTimeout(tm);tm=setTimeout(function(){var s=sym($("fc").value);if(s&&!(s in P))fb(s)},600)}}});
$("aX").onclick=function(){$("ovA").classList.remove("show")};
$("aS").onclick=function(){
 var s=sym($("fc").value),t={s:s,sd:sd,lv:+$("fl").value,mg:+$("fm").value,en:+$("fe").value,tp:+$("ft").value||0,sl:+$("fs").value||0};
 if(!s||!(t.en>0)||!(t.mg>0)||!(t.lv>=1)){alert("Coin, leverage, margin aur entry price bharo");return}
 T.unshift(t);sv();$("ovA").classList.remove("show");render();
};
$("cU").onclick=function(){var t=T[cur];t.tp=+$("cT").value||0;t.sl=+$("cS").value||0;sv();render()};
$("cD").onclick=function(){if(confirm("Trade close karke hata dein?")){T.splice(cur,1);sv();$("ovC").classList.remove("show");render()}};
$("cX").onclick=function(){$("ovC").classList.remove("show")};
["ovA","ovC"].forEach(function(i){$(i).onclick=function(e){if(e.target===this)this.classList.remove("show")}});
render();pull();setInterval(pull,3000);
})();
//]]>
</script>
</body></html>
